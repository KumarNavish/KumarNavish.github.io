{
  "version": "1.0",
  "processes": [
    {
      "process_id": "access_request",
      "display_name": "Access Entitlement Change",
      "description": "Handle joiner/mover/leaver access changes for internal platforms with governance controls.",
      "required_fields": [
        "subject_user",
        "system_name",
        "access_level",
        "justification",
        "manager_approval"
      ],
      "default_owner_role": "identity_governance_analyst",
      "default_sla_hours": 12,
      "required_approvals": [
        "line_manager",
        "application_owner"
      ],
      "target_schema": {
        "required_keys": [
          "plan_version",
          "process_id",
          "title",
          "owner_role",
          "sla_hours",
          "risk_tag",
          "approvals",
          "required_fields",
          "next_actions",
          "controls"
        ],
        "required_fields": [
          "subject_user",
          "system_name",
          "access_level",
          "justification",
          "manager_approval"
        ]
      }
    },
    {
      "process_id": "vendor_onboarding",
      "display_name": "Third-Party Due Diligence Intake",
      "description": "Screen, assess, and onboard external vendors with sanctions, security, and compliance checks.",
      "required_fields": [
        "vendor_name",
        "country",
        "service_scope",
        "security_review_ticket",
        "tax_form_status"
      ],
      "default_owner_role": "third_party_risk_analyst",
      "default_sla_hours": 72,
      "required_approvals": [
        "procurement_owner",
        "information_security",
        "compliance_officer"
      ],
      "target_schema": {
        "required_keys": [
          "plan_version",
          "process_id",
          "title",
          "owner_role",
          "sla_hours",
          "risk_tag",
          "approvals",
          "required_fields",
          "next_actions",
          "controls"
        ],
        "required_fields": [
          "vendor_name",
          "country",
          "service_scope",
          "security_review_ticket",
          "tax_form_status"
        ]
      }
    },
    {
      "process_id": "purchase_request",
      "display_name": "Policy-Compliant Procurement Request",
      "description": "Route spend requests through budget, procurement, and policy controls.",
      "required_fields": [
        "requester_department",
        "item_description",
        "estimated_cost_usd",
        "budget_code",
        "preferred_supplier"
      ],
      "default_owner_role": "procurement_operations",
      "default_sla_hours": 48,
      "required_approvals": [
        "budget_owner",
        "procurement_owner"
      ],
      "target_schema": {
        "required_keys": [
          "plan_version",
          "process_id",
          "title",
          "owner_role",
          "sla_hours",
          "risk_tag",
          "approvals",
          "required_fields",
          "next_actions",
          "controls"
        ],
        "required_fields": [
          "requester_department",
          "item_description",
          "estimated_cost_usd",
          "budget_code",
          "preferred_supplier"
        ]
      }
    },
    {
      "process_id": "incident_escalation",
      "display_name": "Critical Operations Incident Escalation",
      "description": "Escalate high-impact internal service incidents with clear ownership, severity, and SLA controls.",
      "required_fields": [
        "incident_id",
        "severity",
        "service_name",
        "customer_impact",
        "oncall_owner"
      ],
      "default_owner_role": "operations_incident_manager",
      "default_sla_hours": 2,
      "required_approvals": [
        "operations_oncall",
        "service_owner"
      ],
      "target_schema": {
        "required_keys": [
          "plan_version",
          "process_id",
          "title",
          "owner_role",
          "sla_hours",
          "risk_tag",
          "approvals",
          "required_fields",
          "next_actions",
          "controls"
        ],
        "required_fields": [
          "incident_id",
          "severity",
          "service_name",
          "customer_impact",
          "oncall_owner"
        ]
      }
    }
  ]
}
